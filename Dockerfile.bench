# Harness-Bench runtime derived from Second Brain's general-purpose image.
#
# The application image stays general. This layer only adds a reproducible
# data-tree seed, the benchmark driver, and Harness-Bench's tiny Python
# dependency. Harness-Bench itself is supplied from a pinned checkout at run
# time because its upstream repository currently has no code license.
ARG SB_BASE_IMAGE=second-brain:latest
FROM ${SB_BASE_IMAGE}

USER root

# Several official software-engineering oracles execute JavaScript tests. This
# runtime is reserved for the root-owned scorer; the evaluated agent must
# provision its own runtime when it needs one.
RUN apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Store package files live in the seed, while their import dependencies belong
# to the image. PyYAML is the only dependency declared by Harness-Bench.
RUN PIP_USER=0 pip install --no-cache-dir --no-user \
        litellm==1.97.0 Pillow "PyYAML>=6.0"

COPY --chown=1000:1000 ["template/Second Brain/", "/seed/"]
COPY --chown=1000:1000 template/template_manifest.json /seed/template_manifest.json
COPY --chown=1000:1000 driver/ /opt/sb-driver/driver/
COPY --chown=1000:1000 harness/ /opt/sb-evals/harness/
COPY --chown=1000:1000 entrypoint.py /opt/sb-evals/entrypoint.py
COPY --chown=1000:1000 evals/harness_bench/drive_round.py /opt/sb-evals/drive_round.py
COPY --chown=0:0 isolated_driver.py /opt/sb-evals/isolated_driver.py

RUN mkdir -p /work/live /work/harnessbench \
    && chown -R 1000:1000 /work /opt/sb-driver /opt/sb-evals /seed

USER 1000:1000

ENV SB_SEED_DIR=/seed \
    SB_TEMPLATE_MANIFEST=/seed/template_manifest.json \
    SB_LLM_USAGE_LOG=/work/live/llm_usage.jsonl \
    SB_LIVE_EVENT_LOG=/work/live/events.jsonl

# The base entrypoint performs the normal seed operation before executing this
# command. The wrapper writes run-only secrets into that copied data tree and
# starts the unmodified application.
CMD ["python", "/opt/sb-evals/entrypoint.py"]
